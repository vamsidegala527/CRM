DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/customer_db
SECRET_KEY=change_this_to_a_random_secure_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=your_google_client_id_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Gmail SMTP Email Service (Sends to ANY email address)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=Customer Hub
SMTP_TLS=true

# Optional: Resend API Configuration
RESEND_API_KEY=re_your_api_key_here
FRONTEND_URL=http://localhost:3000

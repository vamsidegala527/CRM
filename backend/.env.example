DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/customer_db
SECRET_KEY=change_this_to_a_random_secure_secret_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=your_google_client_id_here
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# SMTP email service. Use the host and port supplied by your SMTP provider.
# Port 2525 is commonly available when cloud platforms restrict 587/465.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_16_char_google_app_password
SMTP_FROM_EMAIL=onboarding@resend.dev
SMTP_FROM_NAME=Customer Hub
SMTP_TLS=true

FRONTEND_URL=http://localhost:3000
